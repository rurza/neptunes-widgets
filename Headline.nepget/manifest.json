{
    "manifestVersion": 1,
    "id": "pl.micropixels.neptunes.widget.headline",
    "name": "Headline",
    "version": "1.0.10",
    "author": "Adam Różyński",
    "description": "Big-type now playing. Title sized to fit, hairline progress, and color pulled from the album art.",
    "license": "MIT",
    "entry": "index.html",
    "defaultSize": {
        "width": 392,
        "height": 230
    },
    "minSize": {
        "width": 332,
        "height": 200
    },
    "resizable": false,
    "preview": "preview.jpg",
    "permissions": [
        "artwork",
        "playbackControl",
        "love"
    ],
    "settings": {
        "schema": [
            {
                "id": "theme",
                "type": "radio",
                "label": "Theme",
                "options": [
                    {
                        "value": "auto",
                        "label": "Auto"
                    },
                    {
                        "value": "dark",
                        "label": "Dark"
                    },
                    {
                        "value": "light",
                        "label": "Light"
                    }
                ],
                "default": "auto"
            },
            {
                "id": "controls",
                "type": "radio",
                "label": "Controls",
                "options": [
                    {
                        "value": "hover",
                        "label": "On hover"
                    },
                    {
                        "value": "always",
                        "label": "Always"
                    }
                ],
                "default": "hover"
            },
            {
                "id": "accentSource",
                "type": "radio",
                "label": "Accent",
                "options": [
                    {
                        "value": "album",
                        "label": "From album art"
                    },
                    {
                        "value": "fixed",
                        "label": "Fixed color"
                    }
                ],
                "default": "album"
            },
            {
                "id": "fixedColor",
                "type": "color",
                "label": "Fixed accent color",
                "default": "#FF375F"
            }
        ]
    },
    "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}