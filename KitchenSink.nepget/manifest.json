{
    "manifestVersion": 1,
    "id": "pl.micropixels.neptunes.widget.kitchen-sink",
    "name": "Kitchen Sink",
    "version": "1.1.2",
    "author": "Adam Różyński",
    "description": "Complete API demo showcasing all available features: playback, volume, ratings, shuffle/repeat, player activation, and more",
    "license": "MIT",
    "homepage": "https://neptunesmac.app",
    "entry": "index.html",
    "defaultSize": {
        "width": 400,
        "height": 440
    },
    "minSize": {
        "width": 400,
        "height": 380
    },
    "resizable": false,
    "preview": "preview.jpg",
    "permissions": [
        "artwork",
        "playbackControl",
        "volumeControl",
        "love",
        "ratingControl",
        "shuffleRepeatControl",
        "playerActivation"
    ],
    "settings": {
        "schema": [
            {
                "id": "showDebug",
                "type": "checkbox",
                "label": "Show State Debug Info",
                "default": false
            }
        ]
    },
    "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}