{
    "manifestVersion": 1,
    "id": "pl.micropixels.neptunes.widget.now-playing",
    "name": "Now Playing",
    "version": "1.9.7",
    "author": "Adam Różyński",
    "description": "Displays the currently playing track with playback controls",
    "license": "MIT",
    "homepage": "https://neptunesmac.app",
    "entry": "index.html",
    "defaultSize": {
        "width": 368,
        "height": 220
    },
    "minSize": {
        "width": 328,
        "height": 200
    },
    "resizable": false,
    "preview": "preview.jpg",
    "permissions": [
        "artwork",
        "playbackControl"
    ],
    "settings": {
        "schema": [
            {
                "id": "showArtwork",
                "type": "checkbox",
                "label": "Show Album Artwork",
                "default": true
            },
            {
                "id": "opacity",
                "type": "slider",
                "label": "Background Opacity",
                "min": 0.3,
                "max": 1,
                "step": 0.1,
                "default": 0.85
            },
            {
                "id": "theme",
                "type": "radio",
                "label": "Theme",
                "options": [
                    {
                        "value": "dark",
                        "label": "Dark"
                    },
                    {
                        "value": "light",
                        "label": "Light"
                    },
                    {
                        "value": "auto",
                        "label": "Auto"
                    }
                ],
                "default": "dark"
            }
        ]
    },
    "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}