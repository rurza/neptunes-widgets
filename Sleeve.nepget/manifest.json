{
    "manifestVersion": 1,
    "id": "pl.micropixels.neptunes.widget.sleeve",
    "name": "Sleeve",
    "version": "1.0.7",
    "author": "Adam Różyński",
    "description": "A floating album cover with the track set beside it, straight on your wallpaper. No card, no controls.",
    "license": "MIT",
    "entry": "index.html",
    "defaultSize": {
        "width": 380,
        "height": 180
    },
    "minSize": {
        "width": 320,
        "height": 160
    },
    "resizable": false,
    "preview": "preview.jpg",
    "permissions": [
        "artwork"
    ],
    "settings": {
        "schema": [
            {
                "id": "theme",
                "type": "radio",
                "label": "Theme",
                "options": [
                    {
                        "value": "auto",
                        "label": "Auto"
                    },
                    {
                        "value": "dark",
                        "label": "Dark"
                    },
                    {
                        "value": "light",
                        "label": "Light"
                    }
                ],
                "default": "auto"
            },
            {
                "id": "textShadow",
                "type": "checkbox",
                "label": "Text shadow (white text only)",
                "default": true
            }
        ]
    },
    "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}