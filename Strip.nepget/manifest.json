{
    "manifestVersion": 1,
    "id": "pl.micropixels.neptunes.widget.strip",
    "name": "Strip",
    "version": "1.0.10",
    "author": "Adam Różyński",
    "description": "A slim now-playing ticker to dock along a screen edge. Long titles scroll; a thin accent line tracks progress.",
    "license": "MIT",
    "entry": "index.html",
    "defaultSize": {
        "width": 584,
        "height": 68
    },
    "minSize": {
        "width": 344,
        "height": 64
    },
    "resizable": false,
    "preview": "preview.jpg",
    "permissions": [
        "artwork",
        "playbackControl"
    ],
    "settings": {
        "schema": [
            {
                "id": "theme",
                "type": "radio",
                "label": "Theme",
                "options": [
                    {
                        "value": "auto",
                        "label": "Auto"
                    },
                    {
                        "value": "dark",
                        "label": "Dark"
                    },
                    {
                        "value": "light",
                        "label": "Light"
                    }
                ],
                "default": "auto"
            },
            {
                "id": "width",
                "type": "select",
                "label": "Width",
                "options": [
                    {
                        "value": "compact",
                        "label": "Compact (420)"
                    },
                    {
                        "value": "wide",
                        "label": "Wide (640)"
                    }
                ],
                "default": "compact"
            },
            {
                "id": "accentSource",
                "type": "radio",
                "label": "Accent",
                "options": [
                    {
                        "value": "album",
                        "label": "From album art"
                    },
                    {
                        "value": "fixed",
                        "label": "Fixed color"
                    }
                ],
                "default": "album"
            },
            {
                "id": "fixedColor",
                "type": "color",
                "label": "Fixed accent color",
                "default": "#FF375F"
            }
        ]
    },
    "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}