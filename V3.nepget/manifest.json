{
  "manifestVersion": 1,
  "id": "pl.micropixels.neptunes.widget.v3",
  "name": "V3",
  "version": "1.1.3",
  "author": "Adam Różyński",
  "description": "The classic NepTunes cover — hover for controls, scroll to change volume, and the track info sweeps up when the song changes.",
  "license": "MIT",
  "homepage": "https://neptunesmac.app",
  "entry": "index.html",
  "preview": "preview.jpg",
  "defaultSize": {
    "width": 200,
    "height": 200
  },
  "minSize": {
    "width": 180,
    "height": 180
  },
  "maxSize": {
    "width": 500,
    "height": 500
  },
  "resizable": true,
  "permissions": [
    "artwork",
    "playbackControl",
    "volumeControl",
    "shuffleRepeatControl",
    "love",
    "playerActivation"
  ],
  "settings": {
    "schema": [
      {
        "id": "hideLabel",
        "type": "checkbox",
        "label": "Hide the title bar",
        "default": false
      },
      {
        "id": "showInfoOnTrackChange",
        "type": "checkbox",
        "label": "Show track info when the song changes",
        "default": true
      },
      {
        "id": "scrollToChangeVolume",
        "type": "checkbox",
        "label": "Scroll over the cover to change volume",
        "default": true
      },
      {
        "id": "doubleClickActivatesPlayer",
        "type": "checkbox",
        "label": "Double-click brings the player forward",
        "default": true
      }
    ]
  },
  "authorPublicKey": "9LnkF5kMetsyjG6MEOtZ/Lo1jUzVyevNC7ubQ12A214="
}
