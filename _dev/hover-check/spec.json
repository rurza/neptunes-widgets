{
 "_": "One case per element whose visibility a hover affordance drives. `settings` holds only the OVERRIDES for the case — the manifest's own defaults are merged in first — and the window is `manifest.defaultSize`. `expect` is \"hover-gated\" (off screen, revealed by the host's `nt-hover` class, off screen again when it leaves) or \"always-visible\". `inert: true` also requires pointer-events to follow, so the hidden thing cannot be clicked. Opacity is measured up the whole ancestor chain — see README.md.",
 "track": {
  "title": "Wszystko czego dziś chcę",
  "artist": "Robyn",
  "album": "Honey",
  "duration": 230,
  "isLoved": true,
  "artworkData": ""
 },
 "cases": [
  {
   "widget": "Glass",
   "settings": {
    "controls": "hover"
   },
   "selector": ".panel",
   "expect": "hover-gated",
   "inert": true,
   "why": "On hover hides the whole frosted sheet; hiding only the transport left a blank slab of glass with a hole in it"
  },
  {
   "widget": "Glass",
   "settings": {
    "controls": "hover"
   },
   "selector": ".controls",
   "expect": "hover-gated",
   "why": "the transport rides the sheet it sits on"
  },
  {
   "widget": "Glass",
   "settings": {
    "controls": "always"
   },
   "selector": ".panel",
   "expect": "always-visible",
   "why": "Always is the default, and it must survive the pointer coming and going"
  },
  {
   "widget": "Stack",
   "settings": {
    "controls": "hover"
   },
   "selector": ".controls",
   "expect": "hover-gated",
   "why": "Stack has no sheet — the row itself is the affordance"
  },
  {
   "widget": "Stack",
   "settings": {
    "controls": "always"
   },
   "selector": ".controls",
   "expect": "always-visible",
   "why": "Always keeps the row pinned"
  },
  {
   "widget": "Headline",
   "settings": {
    "controls": "hover"
   },
   "selector": ".controls",
   "expect": "hover-gated",
   "why": "same row-only affordance as Stack"
  },
  {
   "widget": "Headline",
   "settings": {
    "controls": "always"
   },
   "selector": ".controls",
   "expect": "always-visible",
   "why": "Always keeps the row pinned"
  },
  {
   "widget": "V3",
   "settings": {},
   "selector": ".hover",
   "expect": "hover-gated",
   "inert": true,
   "why": "the reference implementation: a full-cover panel gated on nt-hover, inert while hidden"
  }
 ]
}
